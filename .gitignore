# ==============================================================================
# 🚀 KIDECO Fuel Ratio Project — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 🐍 Python & FastAPI Microservice
# ------------------------------------------------------------------------------
python-ai-service/__pycache__/
python-ai-service/*.py[cod]
python-ai-service/*$py.class
python-ai-service/.pytest_cache/
python-ai-service/venv/
python-ai-service/env/
python-ai-service/.venv/
python-ai-service/*.db
python-ai-service/*.sqlite
python-ai-service/*.sqlite3
python-ai-service/.env
python-ai-service/.env.*
!python-ai-service/.env.example

# General Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ------------------------------------------------------------------------------
# 🐘 Laravel 11 & PHP Backend
# ------------------------------------------------------------------------------
laravel/vendor/
laravel/bootstrap/cache/*
!laravel/bootstrap/cache/.gitignore
laravel/storage/*.key
laravel/storage/logs/*
!laravel/storage/logs/.gitignore
laravel/storage/framework/cache/*
!laravel/storage/framework/cache/.gitignore
laravel/storage/framework/sessions/*
!laravel/storage/framework/sessions/.gitignore
laravel/storage/framework/views/*
!laravel/storage/framework/views/.gitignore
laravel/storage/app/*
!laravel/storage/app/.gitignore
laravel/database/*.sqlite
laravel/database/*.sqlite-journal
laravel/.phpunit.result.cache
laravel/.php-cs-fixer.cache
laravel/auth.json
laravel/composer.phar
laravel/.env
laravel/.env.backup
laravel/.env.production
laravel/.env.local
laravel/.env.*.local
!laravel/.env.example

# ------------------------------------------------------------------------------
# ⚡ Node.js, Vite & Vue 3 Frontend
# ------------------------------------------------------------------------------
laravel/node_modules/
laravel/public/build/
laravel/public/hot
laravel/public/storage
laravel/dist/
laravel/dist-ssr/
laravel/.eslintcache
laravel/.stylelintcache
laravel/.tsbuildinfo
laravel/npm-debug.log*
laravel/yarn-debug.log*
laravel/yarn-error.log*
laravel/pnpm-debug.log*
laravel/pnpm-lock.yaml

# ------------------------------------------------------------------------------
# 🔒 Environment & Global Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 💻 IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini